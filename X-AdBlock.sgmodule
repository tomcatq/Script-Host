#!name=X (Twitter) AdBlock
#!desc=Filters marked promoted posts in X timeline JSON. Requires HTTPS Decryption.
#!category=AdBlock

[Rule]
# Send HTTP/3 on the X API hosts back to TCP so HTTPS Decryption can inspect it.
AND,((DOMAIN,api.x.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP
AND,((DOMAIN,api.twitter.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP

[Script]
x-adblock = type=http-response,pattern=^https:\/\/api\.(?:x|twitter)\.com\/(?:graphql\/[A-Za-z0-9_-]+\/(?:HomeTimeline(?:Latest)?|HomeLatestTimeline|ConversationTimeline(?:V2)?|TweetDetail|SearchTimeline(?:Query)?|Profile(?:WithReplies)?Timeline|UserTweets(?:AndReplies)?|ListLatestTweetsTimeline)|2\/(?:timeline\/(?:home(?:_latest)?|conversation\/[0-9]+|profile\/[0-9]+)|search\/adaptive)\.json)(?:\?[^#]*)?$,requires-body=1,max-size=4194304,timeout=5,engine=webview,script-path=https://raw.githubusercontent.com/tomcatq/Script-Host/refs/heads/main/x-adblock.js?v=1

[MITM]
hostname = %APPEND% api.x.com, api.twitter.com
