#!name=知乎去广告 Zhihu AdBlock (Question Navigation Fix)
#!desc=Removes Zhihu splash, feed, hot-list and answer ads, including the card above comments. Requires HTTPS decryption (MITM) with a trusted CA certificate.
#!author=You
#!category=AdBlock
#!homepage=https://www.zhihu.com

# Install the updated zhihu_ads.js at the script-path below or set script-path to
# zhihu_ads.js after saving the updated script in Shadowrocket's local script picker.

[Rule]
# Block QUIC (HTTP/3 over UDP) for zhihu.com so the app falls back to TCP/HTTPS for MITM.
AND,((DST-PORT,443),(PROTOCOL,UDP),(DOMAIN-SUFFIX,zhihu.com)),REJECT-NO-DROP
# Zhihu HTTPDNS (Baidu Cloud HTTPDNS).
# Use REJECT-NO-DROP (fast-fail TCP RST / ICMP unreachable) so Zhihu immediately falls back to system DNS.
DOMAIN,httpdns.baidubce.com,REJECT-NO-DROP
IP-CIDR,182.61.194.7/32,REJECT-NO-DROP,no-resolve
IP-CIDR,182.61.194.9/32,REJECT-NO-DROP,no-resolve
IP-CIDR,106.13.244.173/32,REJECT-NO-DROP,no-resolve
IP-CIDR6,240c:409f:1000::4:0:a5/128,REJECT-NO-DROP,no-resolve
# Older HTTPDNS addresses:
IP-CIDR,118.89.204.198/32,REJECT-NO-DROP,no-resolve
IP-CIDR6,2402:4e00:1200:ed00:0:9089:6dac:96b6/128,REJECT-NO-DROP,no-resolve
# Third-party ad SDKs and ad-tracking hosts
# Tencent GDT (广点通 / 优量汇)
DOMAIN-SUFFIX,gdt.qq.com,REJECT-NO-DROP
DOMAIN-SUFFIX,gdtimg.com,REJECT-NO-DROP
DOMAIN-SUFFIX,ugdtimg.com,REJECT-NO-DROP
# Kuaishou ad network
DOMAIN,open.kuaishouzt.com,REJECT-NO-DROP
DOMAIN,open.kwaizt.com,REJECT-NO-DROP
# ByteDance Pangolin
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT-NO-DROP
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT-NO-DROP
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT-NO-DROP
# Alibaba Tanx
DOMAIN-SUFFIX,tanx.com,REJECT-NO-DROP
DOMAIN,tanx-creative.taobao.com,REJECT-NO-DROP
# Ad impression and tracking
DOMAIN-SUFFIX,ad.xelements.cn,REJECT-NO-DROP
DOMAIN-SUFFIX,miaozhen.com,REJECT-NO-DROP

[URL Rewrite]
# ---------- HTTPDNS over plain HTTP: reject immediately so Zhihu falls back to system DNS ----------
^http:\/\/\d+\.\d+\.\d+\.\d+\/v2\/resolv\?host= - reject
# ---------- Splash / launch ads ----------
^https?:\/\/api\.zhihu\.com\/commercial_api\/(launch_v2|real_time_launch_v2) - reject-dict
^https?:\/\/api\.zhihu\.com\/launch\? - reject-dict
# ---------- Floating layers, banners and pop-ups ----------
^https?:\/\/api\.zhihu\.com\/commercial_api\/(app_float_layer|banners_v3) - reject-dict
^https?:\/\/api\.zhihu\.com\/market\/popovers - reject-dict
^https?:\/\/api\.zhihu\.com\/ad-style-service\/ - reject-dict
^https?:\/\/api\.zhihu\.com\/brand\/question\/\d+\/card - reject-dict
# ---------- Recommendation/ad cards under answers and above comments ----------
^https?:\/\/api\.zhihu\.com\/commercial_api\/answer\/\d+\/bottom-v2(?:[?#]|$) - reject-dict
^https?:\/\/api\.zhihu\.com\/(api\/)?v\d\/answers\/\d+\/recommendations - reject-dict
^https?:\/\/api\.zhihu\.com\/.*\/comments\/featured-comment-ad - reject-dict
# ---------- Ad tracking ----------
^https?:\/\/api\.zhihu\.com\/(fringe|zst\/events) - reject-dict
# ---------- Optional: remove the preset words in the search box (uncomment to enable) ----------
# ^https?:\/\/api\.zhihu\.com\/search\/preset_words - reject-dict

[Script]
# Only intercept the specific feed, question-answer list, answer-detail, and next-render endpoints that can carry ad JSON.
# Avoiding broad /questions, /answers, and /comments sub-requests prevents overloading multiplexed HTTP/2 MITM streams.
zhihu-ads = type=http-response,pattern=^https?:\/\/api\.zhihu\.com\/(topstory\/(recommend|hot-lists?)|moments(_v\d)?|feed-root|(api\/)?(v\d+\/)?questions\/\d+\/(answers|feeds)\b|answers\/v2\/\d+(?:[?#]|$)|next-(render|data|bff)|search_v3|v5\.1\/topics|prague\/),requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/tomcatq/Script-Host/main/zhihu_ads.js

[MITM]
hostname = %APPEND% api.zhihu.com
