#!name=X (Twitter) AdBlock
#!desc=Remove ads and promoted tweets in X (Twitter) for iOS.
#!author=YourName
#!category=AdBlock
#!system=ios

[Rule]
# Block tracking and dedicated ad domains
DOMAIN, ads-twitter.com, REJECT
DOMAIN, telemetry.twitter.com, REJECT
DOMAIN, tracking.twitter.com, REJECT
DOMAIN, static.ads-twitter.com, REJECT
DOMAIN-SUFFIX, ads-twitter.com, REJECT
DOMAIN-SUFFIX, ads.twitter.com, REJECT

[Script]
# Intercept GraphQL and timeline endpoints
X_AdBlock = type=http-response,pattern=^https?:\/\/api\.(twitter|x)\.com\/(graphql|\d+(\.\d+)?\/timeline),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/tomcatq/Script-Host/main/x-adblock.js

[MITM]
hostname = %APPEND% api.twitter.com, api.x.com
