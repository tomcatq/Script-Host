#!name=YouTube - Fixed (WebView Repair)
#!desc=YouTube ad filtering, background playback flags and YouTube Music tab filtering. Requires HTTPS Decryption.
#!author=Maasea (protobuf codecs); local Shadowrocket adaptation
#!arguments=Diagnostics:false
#!arguments-desc=Enable Diagnostics to log whether the response script applied an edit.

[Rule]
# Restore TCP fallback for the media and API hosts used by the original module.
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei-att.googleapis.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP

[URL Rewrite]
# Apply the original empty response fallback only to initplayback with an oad key.
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback\?(?:[^&#]*&)*oad(?:=[^&#]*)?(?:&[^#]*)?$ _ reject-200

[Script]
# Limit response buffering before the body reaches the script.
youtube.fixed.response = type=http-response,pattern=^https:\/\/youtubei(?:-att)?\.googleapis\.com\/youtubei\/v1\/(?:browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(?:\?[^#]*)?$,requires-body=1,max-size=1048576,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/tomcatq/Script-Host/refs/heads/main/youtube.fixed.response.js?revision=webview-repair,argument={{{Diagnostics}}}

[MITM]
hostname = %APPEND% -redirector*.googlevideo.com, *.googlevideo.com, youtubei.googleapis.com, youtubei-att.googleapis.com
