#!name=YouTube - Fixed (Local)
#!desc=YouTube iOS ad filtering and background playback flags. Requires HTTPS Decryption and youtube.fixed.response.js.
#!author=Maasea (protobuf codecs); local Shadowrocket adaptation

[Rule]
# Send these API requests over TCP so Shadowrocket can decrypt them.
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP
AND,((DOMAIN,youtubei-att.googleapis.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP

[Script]
youtube.fixed.response = type=http-response,pattern=^https:\/\/youtubei(?:-att)?\.googleapis\.com\/youtubei\/v1\/(?:browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(?:\?[^#]*)?$,requires-body=1,max-size=4194304,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/tomcatq/Script-Host/refs/heads/main/youtube.fixed.response.js

[MITM]
hostname = %APPEND% youtubei.googleapis.com, youtubei-att.googleapis.com
