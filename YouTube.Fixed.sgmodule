#!name=YouTube - Fixed
#!desc=YouTube module with explicit script options and additive HTTPS hostnames. Requires a trusted Shadowrocket CA and HTTPS decryption.
#!author=Maasea (YouTube script); local configuration repair
Prepared: 2026-11-03
Based on the user's supplied module. Script stays pinned to its original commit.
Fixed options: WebView engine; translations off; hide upload/immersive buttons;
debug off. No template substitution or module arguments are required.
[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[URL Rewrite]
(^https?://[\w-]+.googlevideo.com/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302
^https?://[\w-]+.googlevideo.com/(?!(dclk_video_ads|videoplayback?)).+&oad _ reject-200
^https?://(www|s).youtube.com/api/stats/ads _ reject-200
^https?://(www|s).youtube.com/(pagead|ptracking) _ reject-200
^https?://s.youtube.com/api/stats/qoe?adcontext _ reject-200

[Script]
youtube.response = type=http-response,pattern=^https://youtubei.googleapis.com/youtubei/v1/(browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch),requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/tomcatq/Script-Host/refs/heads/main/youtube.fixed.response.js,argument="{"lyricLang":"off","captionLang":"off","blockUpload":true,"blockImmersive":true,"debug":false}"

[MITM]
hostname = %APPEND% -redirector*.googlevideo.com, *.googlevideo.com, www.youtube.com, s.youtube.com, youtubei.googleapis.com
